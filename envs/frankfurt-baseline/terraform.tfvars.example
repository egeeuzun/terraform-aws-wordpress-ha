# terraform.tfvars olarak kopyalayin (*.tfvars git'e girmez).

# wp-admin'e erisecek IP'ler. Bos birakilir ve VPN kapali olursa wp-admin
# kisitlamasiz kalir (WAF yine aktif).
admin_extra_allowed_cidrs = ["203.0.113.4/32"]

# Imaj build/deploy hatti (wordpress-shop-demo reposu)
enable_cicd             = true
codestar_connection_arn = "arn:aws:codestar-connections:eu-central-1:ACCOUNT_ID:connection/CONNECTION_ID"
repository_id           = "ORG/wordpress-shop-demo"
branch                  = "main"

# Pritunl yonetim VPN'i (opsiyonel)
# enable_vpn         = true
# vpn_admin_cidrs    = ["203.0.113.4/32"]
# vpn_wireguard_port = 12712
